includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:

    paths:
        - app

    # The level 9 is the highest level
    level: 6

    ignoreErrors:
        - '#Unsafe usage of new static#'

    excludePaths:
        - ./backEnd/app/Controllers/AuthController.php

    checkMissingIterableValueType: false
